<section class="yze-item-sheet yze-sheet">
  <header class="sheet-header yze-item-header">
    <div class="yze-item-type">{{item.type}}</div>
    <h1 class="yze-item-title">
      <input name="name" type="text" value="{{item.name}}" />
    </h1>
  </header>

  <section class="sheet-section yze-item-meta">
    <label class="yze-field">
      <input type="checkbox"
             data-action="toggleItemEquipped"
             {{#if system.equipped}}checked{{/if}} />
      {{localize "YZE.Item.Equipped"}}
    </label>
  </section>

  <section class="sheet-section yze-modifiers yze-item-modifiers">
    <h2>{{localize "YZE.Modifier.Title"}}</h2>
    <div class="yze-modifier-list">
      {{#each modifiers as |mod|}}
        <div class="yze-row yze-modifier-row" data-modifier-id="{{mod.id}}">
          <input type="number"
                 class="yze-input"
                 data-action="editItemModifier"
                 data-field="value"
                 data-id="{{mod.id}}"
                 value="{{mod.value}}"
                 step="1" />

          <select data-action="editItemModifier"
                  data-field="scope"
                  data-id="{{mod.id}}">
            <option value="all" {{#if (eq mod.scope "all")}}selected{{/if}}>{{localize "YZE.Item.ModifierScope.All"}}</option>
            <option value="attribute" {{#if (eq mod.scope "attribute")}}selected{{/if}}>{{localize "YZE.Item.ModifierScope.Attribute"}}</option>
            <option value="skill" {{#if (eq mod.scope "skill")}}selected{{/if}}>{{localize "YZE.Item.ModifierScope.Skill"}}</option>
          </select>

          {{#if (eq mod.scope "attribute")}}
            {{#if @root.yze.hasActiveSetting}}
              <select data-action="editItemModifier"
                      data-field="attribute"
                      data-id="{{mod.id}}">
                <option value="">{{localize "YZE.Item.AttributeOption"}}</option>
                {{#each @root.attributeOptions as |attr|}}
                  <option value="{{attr.id}}" {{#if (eq attr.id ../mod.attribute)}}selected{{/if}}>
                    {{attr.name}}
                  </option>
                {{/each}}
              </select>
            {{else}}
              <input type="text"
                     class="yze-input"
                     placeholder="{{localize 'YZE.Item.AttributeOption'}} id"
                     data-action="editItemModifier"
                     data-field="attribute"
                     data-id="{{mod.id}}"
                     value="{{mod.attribute}}" />
            {{/if}}
          {{/if}}

          {{#if (eq mod.scope "skill")}}
            {{#if @root.yze.hasActiveSetting}}
              <select data-action="editItemModifier"
                      data-field="skill"
                      data-id="{{mod.id}}">
                <option value="">{{localize "YZE.Item.SkillOption"}}</option>
                {{#each @root.skillOptions as |skill|}}
                  <option value="{{skill.id}}" {{#if (eq skill.id ../mod.skill)}}selected{{/if}}>
                    {{skill.name}}
                  </option>
                {{/each}}
              </select>
            {{else}}
              <input type="text"
                     class="yze-input"
                     placeholder="{{localize 'YZE.Item.SkillOption'}} id"
                     data-action="editItemModifier"
                     data-field="skill"
                     data-id="{{mod.id}}"
                     value="{{mod.skill}}" />
            {{/if}}
          {{/if}}

          <input type="text"
                 class="yze-input"
                 placeholder="{{localize 'YZE.Item.LabelPlaceholder'}}"
                 data-action="editItemModifier"
                 data-field="label"
                 data-id="{{mod.id}}"
                 value="{{mod.label}}" />

          <button type="button"
                  data-action="removeItemModifier"
                  data-id="{{mod.id}}">
            {{localize "YZE.Common.Remove"}}
          </button>
        </div>
      {{/each}}
    </div>

    <button type="button" data-action="addItemModifier">
      + {{localize "YZE.Common.AddModifier"}}
    </button>
  </section>

  <section class="sheet-section">
    <h2>{{localize "YZE.Item.Notes"}}</h2>
    <textarea name="system.description" rows="8">{{system.description}}</textarea>
  </section>
</section>
