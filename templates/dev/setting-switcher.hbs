<section class="yze-setting-switcher">
  <header class="yze-header">
    <h2>{{localize "YZE.Setting.Menu.Title"}}</h2>
    <p class="hint">
      {{localize "YZE.Setting.SwitcherDescription"}}
    </p>
    <p class="hint">
      {{localize "YZE.Setting.SwitcherActive"}}: {{#if active}}{{active.name}} ({{active.id}}){{else}}{{localize "YZE.Setting.SwitcherNoneActive"}}{{/if}}
    </p>
    <p class="hint">
      Persisted: {{#if persisted}}{{persisted.name}} ({{persisted.id}}){{else}}None{{/if}}
    </p>
  </header>

  {{#if settings.length}}
    <div class="yze-list">
      {{#each settings as |s|}}
        <div class="yze-row">
          <div class="yze-label">{{s.name}} ({{s.id}})</div>
          {{#if s.isActive}}
            <button type="button" class="yze-btn yze-btn-deactivate" data-action="deactivate" data-id="{{s.id}}">
              Deactivate
            </button>
          {{else}}
            <button type="button" class="yze-btn yze-btn-activate" data-action="activate" data-id="{{s.id}}">
              Activate
            </button>
          {{/if}}
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="hint">{{localize "YZE.Setting.SwitcherNone"}}</p>
  {{/if}}
</section>
